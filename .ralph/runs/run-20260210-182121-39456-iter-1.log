+  const urls = outlines
+    .map((outline) => outline.getAttribute('xmlUrl'))
+    .filter((value) => typeof value === 'string')
+    .map((value) => value.trim())
+    .filter((value) => value.length > 0 && isValidHttpUrl(value));
+
+  if (urls.length === 0) {
+    throw new Error('invalid_opml');
+  }
+
+  return urls;
+}
